# Copy to .env. Every value below is the default, except the password.

# Neo4j, over Bolt. The workspace compose file publishes it on 7387 — 7687 is
# the container's port, remapped because the default is commonly taken.
NEO4J_URI=bolt://localhost:7387
NEO4J_USERNAME=neo4j
# FILL THIS IN. It matches NEO4J_PASSWORD in the workspace .env, which the
# compose file defaults to `changeme`.
NEO4J_PASSWORD=changeme

# The shared broker. Every aether-zone service publishes to this one exchange;
# a broker of arachni's own would leave it subscribed to nothing.
RABBITMQ_URI=amqp://aether-zone:Ch4nG3M3!@localhost:5682
RABBITMQ_EXCHANGE=aether-zone
RABBITMQ_CONNECT_TIMEOUT_MS=10000

PORT=3120
LOG_LEVEL=debug
